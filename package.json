{
  "name": "mappai-studente",
  "version": "0.1.0",
  "description": "MappAI studente — l'app dello studente per iPad: apre un vault ricevuto dal docente, mostra la mappa, i materiali, flashcard e prove",
  "author": {
    "name": "Giacomo Meschini",
    "email": "giacomo@insegnai.ch"
  },
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "sincronizza": "node tools/sincronizza.js",
    "verifica": "node tools/sincronizza.js --verifica",
    "vault-json": "node tools/vault-json.js",
    "serve": "python3 -m http.server 8766 -d public",
    "ios": "npx cap add ios; python3 tools/plist-ipad.py && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  },
  "license": "ISC"
}
